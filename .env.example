# App
NEXT_PUBLIC_URL=http://localhost:3000
NODE_ENV=development

# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# Stripe Payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_ID=price_xxxxx

# Uploadthing (Image uploads)
UPLOADTHING_TOKEN=xxxxx

# Backup automation (used by scripts/backup-convex-to-uploadthing.ts and GitHub Actions)
CONVEX_DEPLOY_KEY=prod:your-deployment|xxxxx
BACKUP_ENCRYPTION_KEY=generate_a_long_random_value

# Map APIs
NEXT_PUBLIC_OPENAIP_API_KEY=xxxxx
OPENWEATHERMAP_API_KEY=xxxxx

# Aviation Weather
AVWX_TOKEN=xxxxx
AVIAPAGES_API_KEY=xxxxx

# Resend (Email notifications)
# Also set RESEND_API_KEY in the Convex deployment for scheduled moderation emails.
RESEND_API_KEY=re_xxxxx

# Internal system auth for trusted server-to-Convex mutations
CONVEX_SYSTEM_SECRET=change_me

# Server-only key for screening pilot ACARS entries before publication
OPENAI_API_KEY=sk_xxxxx

# vstrips integration
VSTRIPS_INTEGRATION_SECRET=change_me

# PostHog Analytics (optional - only tracks in production)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=phx_xxxxx
POSTHOG_PROJECT_ID=00000

# Google AdSense (public publisher identifier)
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-5174559718233522
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT=8811855745
