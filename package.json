{
  "name": "geofs-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "node scripts/build-userscript.mjs && next build",
    "build:userscript": "node scripts/build-userscript.mjs",
    "build:userscript:dev": "node scripts/build-dev-userscript.mjs",
    "backup:convex": "tsx scripts/backup-convex-to-uploadthing.ts",
    "convex:dev": "convex dev",
    "sync:convex:prod-to-dev": "tsx scripts/sync-convex-prod-to-dev.ts",
    "check": "eslint . && tsc --noEmit",
    "cf": "cloudflared tunnel run dev-tunnel",
    "stripe": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:active-flight-sessions": "tsx --test convex/activeFlightSessions.test.ts",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:moderation": "tsx --test convex/moderation.test.ts"
  },
  "engines": {
    "node": ">=20 <26",
    "pnpm": ">=11 <12"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.36.5",
    "@clerk/themes": "^2.4.46",
    "@posthog/nextjs-config": "^1.9.68",
    "@radix-ui/react-switch": "^1.2.6",
    "@stripe/stripe-js": "^8.6.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.21",
    "@uploadthing/react": "^7.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.5",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "hls.js": "^1.6.15",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "leaflet-marker-rotation": "^0.4.0",
    "lucide-react": "^0.555.0",
    "next": "15.5.9",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.336.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.1",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "resend": "^6.8.0",
    "sonner": "^2.0.7",
    "stripe": "^20.1.0",
    "svix": "^1.82.0",
    "uploadthing": "^7.7.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.7",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@11.23.0"
}
